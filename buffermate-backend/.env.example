# ==============================================================================
# BUFFERMATE BACKEND ENVIRONMENT CONFIGURATION (Laravel 11 / PHP 8.3)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="BufferMate Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'pgsql' for PostgreSQL (Supabase / Render Postgres) or 'sqlite' for local dev
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buffermate
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# 4. STATE, CACHE & QUEUE DRIVERS
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# 5. SUPABASE AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT Secret is critical for cryptographic HMAC-SHA256 signature verification:
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------------------------------------------------------
# 6. FILE STORAGE (S3-Compatible / Local)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 7. AI CONFIGURATION (Gemini & OpenAI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
NEWSPILOT_GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
NEWSPILOT_GEMINI_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
OPENAI_API_KEY=
AI_FORCE_MOCK=false

# ------------------------------------------------------------------------------
# 8. NEWSPILOT EDITORIAL WORKFLOW
# ------------------------------------------------------------------------------
NEWSPILOT_POST_STATUS=publish
NEWSPILOT_HUMAN_APPROVAL_REQUIRED=0
NEWSPILOT_PUBLIC_SITE_URL=https://bokoti.com
NEWSPILOT_FB_ENABLED=1

# ------------------------------------------------------------------------------
# 9. SOCIAL OAUTH & API KEYS
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
NEWSPILOT_FB_PAGE_ID=
NEWSPILOT_FB_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 10. AT-REST TOKEN ENCRYPTION
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=32_character_hex_or_string_key_here

# ------------------------------------------------------------------------------
# 11. BACHS PAYMENT GATEWAY (https://docs.bachs.io/)
# ------------------------------------------------------------------------------
BACHS_API_KEY=
BACHS_API_BASE_URL=https://api.bachs.io/v1
BACHS_WEBHOOK_SECRET=
BACHS_DEFAULT_CURRENCY=USD
BACHS_PRO_MONTHLY_PRODUCT_ID=
BACHS_PRO_ANNUAL_PRODUCT_ID=
BACHS_AGENCY_MONTHLY_PRODUCT_ID=
BACHS_AGENCY_ANNUAL_PRODUCT_ID=
