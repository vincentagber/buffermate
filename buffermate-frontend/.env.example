# ==============================================================================
# BUFFERMATE FRONTEND ENVIRONMENT CONFIGURATION (Next.js)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BACKEND API URLS (Required)
# ------------------------------------------------------------------------------
# The public canonical URL of the Next.js application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The public URL of the Laravel Backend API (used by client-side browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Server-side proxy target for Next.js API route rewrites (e.g. internal network or direct URL)
LARAVEL_API_URL=http://localhost:8001

# Node execution environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & CLIENT (Required)
# ------------------------------------------------------------------------------
# Supabase project URL and anon/public key for browser authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Optional publishable key if using newer Supabase auth client schema
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service role key (NEVER expose to client; no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection string (Server-side operations only)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. ENCRYPTION & SECURITY (Required for client/server shared secret encryption)
# ------------------------------------------------------------------------------
# 32-character AES encryption key (Server-only)
ENCRYPTION_KEY=32_character_hex_or_string_key_here

# ------------------------------------------------------------------------------
# 4. AI STUDIO CONFIGURATION (Server-side Fallbacks)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
NEWSPILOT_GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
NEWSPILOT_GEMINI_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
OPENAI_API_KEY=
AI_FORCE_MOCK=false

# ------------------------------------------------------------------------------
# 5. NEWSPILOT EDITORIAL WORKFLOW
# ------------------------------------------------------------------------------
NEWSPILOT_POST_STATUS=publish
NEWSPILOT_HUMAN_APPROVAL_REQUIRED=0
NEWSPILOT_PUBLIC_SITE_URL=https://yournewsoutlet.com
NEWSPILOT_FB_ENABLED=1

# ------------------------------------------------------------------------------
# 6. SOCIAL MEDIA OAUTH CREDENTIALS (Server-only OAuth Callbacks)
# ------------------------------------------------------------------------------
# Meta / Facebook & Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
NEWSPILOT_FB_PAGE_ID=
NEWSPILOT_FB_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# X / Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Threads
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (Bachs)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACHS_PAYMENT_URL=https://checkout.bachs.io
