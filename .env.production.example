# ==============================================================================
# BUFFERMATE PRODUCTION DEPLOYMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy these variables into your production hosting platform (Vercel, Render, Railway, AWS, Docker)
# Replace ALL placeholder values with real credentials before deploying.
# NEVER commit real credentials to version control.

# ------------------------------------------------------------------------------
# 1. SUPABASE & DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_jwt_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_jwt_here

# Direct Postgres pool connection string
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOST CONFIGURATION (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. ENCRYPTION & SECURITY (Required for Token Security)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte base64 key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Must be a base64-encoded 32-byte value. A hex string will NOT work.
ENCRYPTION_KEY=your_base64_encoded_32_byte_encryption_key_here

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Production)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ------------------------------------------------------------------------------
# 5. OPENAI & AI ENGINE (Production)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
AI_FORCE_MOCK=false

# ------------------------------------------------------------------------------
# 6. SOCIAL MEDIA OAUTH & INTEGRATIONS (Production)
# ------------------------------------------------------------------------------

# --- Meta (Facebook & Instagram) ---
# https://developers.facebook.com/apps — requires App Review for pages_manage_posts
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- X (Twitter) Developer Portal ---
# https://developer.twitter.com — OAuth 2.0 with PKCE
TWITTER_CLIENT_ID=your_twitter_oauth2_client_id
TWITTER_CLIENT_SECRET=your_twitter_oauth2_client_secret
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- TikTok for Developers ---
# https://developers.tiktok.com — video.publish requires App Review
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# --- LinkedIn Developer Portal ---
# https://www.linkedin.com/developers — add "Share on LinkedIn" product
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# --- Threads API ---
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 7. BACKGROUND WORKER & IDEMPOTENT SCHEDULER
# ------------------------------------------------------------------------------
SCHEDULER_MAX_CONCURRENT=25
