# ==============================================================================
# BUFFERMATE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE & DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Found in your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Direct Postgres connection string (for migrations and server-side Prisma/Drizzle/pg)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOST CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Base URL of the app (used for OAuth redirects and magic link callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. ENCRYPTION & SECURITY (Required for token storage)
# ------------------------------------------------------------------------------
# 32-character encryption key used to securely encrypt social media access tokens in DB
ENCRYPTION_KEY=your_secure_32_character_encryption_key_here!

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Recommended)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6JX0NB54qqwW5watq-VqgEAFfOmVjvmxq6TjxXdqng-7A
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ------------------------------------------------------------------------------
# 5. OPENAI CONFIGURATION (Optional fallback)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
AI_FORCE_MOCK=false

# ------------------------------------------------------------------------------
# 5. SOCIAL MEDIA OAUTH & INTEGRATIONS (Required for live social logins & publishing)
# ------------------------------------------------------------------------------

# --- Meta (Facebook & Instagram) Developer App ---
# https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- X (Twitter) Developer Portal ---
# https://developer.x.com/en/portal/dashboard
TWITTER_CLIENT_ID=your_twitter_oauth2_client_id
TWITTER_CLIENT_SECRET=your_twitter_oauth2_client_secret
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- TikTok for Developers ---
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# --- LinkedIn Developer Portal ---
# https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# --- Threads API ---
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 6. BACKGROUND WORKER & SCHEDULER (Optional)
# ------------------------------------------------------------------------------
SCHEDULER_MAX_CONCURRENT=10
